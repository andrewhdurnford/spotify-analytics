DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
# Required (non-empty) when ENVIRONMENT=production -- startup fails otherwise.
CRON_SECRET=replace-with-random-secret
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
ENABLE_LOCAL_SYNC=false
LOCAL_SYNC_INTERVAL_SECONDS=60
# Comma-separated hostnames the backend will answer for (TrustedHostMiddleware).
# "*" (default) disables the check; set this to the real backend hostname(s) in production.
# Must be non-empty when ENVIRONMENT=production -- startup fails otherwise.
ALLOWED_HOSTS=*
# Trusted proxy IPs for uvicorn's --forwarded-allow-ips (comma-separated, or "*"
# when only the platform's proxy can reach the container). Required behind a
# reverse proxy/load balancer: without it uvicorn ignores X-Forwarded-For, so
# every client shares one request.client.host and per-IP rate limiting becomes a
# single bucket any one client can exhaust for everyone.
FORWARDED_ALLOW_IPS=127.0.0.1
# Timeouts (seconds unless noted)
REQUEST_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
