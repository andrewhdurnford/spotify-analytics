# Copy to .env.home in the repo root (gitignored) and fill in.

# This app's database in the shared Postgres instance (role + database created
# per deploy/home/README.md). Host is `postgres` on the `pg` network.
DATABASE_URL=postgresql://spotify:<password>@postgres:5432/spotify

# Supabase *session pooler* URL (Supabase dashboard -> Connect -> Session pooler,
# port 5432). Works over IPv4. Used to pull missed plays and push nightly backups.
BACKUP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Public hostname of the tunnel, e.g. api.andrewdurnford.com
ALLOWED_HOSTS=

# Same values as the Render backend.
CRON_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
